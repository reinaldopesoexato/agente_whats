PORT=3030
OWNER_NAMES=Reinaldo
# A análise na API é habilitada por conta na interface.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
# Ollama local. Instale o modelo com: ollama pull qwen3-vl:8b
OLLAMA_MODEL=qwen3-vl:8b
# Caminhos para os executáveis e o modelo multilíngue do whisper.cpp
FFMPEG=ffmpeg
WHISPER_BIN=whisper-cli
WHISPER_MODEL=
SUMMARY_TIME=17:30
SUMMARY_TZ=America/Sao_Paulo
# Integração opcional das skills automáticas. Endpoint HTTPS para receber POST.
SKILL_WEBHOOK_URL=
SKILL_WEBHOOK_TOKEN=
# Opcional para diagnóstico do WhatsApp Web
# WHATSAPP_CHROMIUM_PATH="/Applications/Chromium.app/Contents/MacOS/Chromium"
# Tempo de autenticação e de espera sem progresso durante a sincronização
WHATSAPP_AUTH_TIMEOUT_SECONDS=180
WHATSAPP_SYNC_TIMEOUT_SECONDS=600

# Cadastro de rotinas autorizadas pela aba I.A.
# AGENTE_WHATS_ROUTINES=/caminho/rotinas.json

# OCR local de PDF. Configure caminhos absolutos se o serviço não receber seu PATH.
# PDFTOPPM=/caminho/pdftoppm
# TESSERACT=/caminho/tesseract
# TESSDATA_DIR=/caminho/tessdata
# TESSERACT_LANG=por+eng

# Modelo dedicado de geração de imagens
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
